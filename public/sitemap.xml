<!--
  One entry per translation. `/project` and `/en/project` are prerendered too,
  but they are the same document scrolled to a section and their canonical
  points back at the locale home page, so listing them would only earn a
  "duplicate, alternate page with proper canonical tag" notice in Search
  Console.

  Every entry advertises the same complete set of alternates, itself included.
  An hreflang cluster where the two pages disagree about who belongs to it is
  discarded outright, and the translations go back to competing with each
  other instead of pairing up.

  `lastmod` is hand-maintained: bump it when the CV content actually changes,
  and leave it alone for styling or scenery work. A date that moves on every
  deploy teaches crawlers to ignore the field.
-->
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml"
>
  <url>
    <loc>https://armelgandour.fr/</loc>
    <xhtml:link rel="alternate" hreflang="fr" href="https://armelgandour.fr/" />
    <xhtml:link rel="alternate" hreflang="en" href="https://armelgandour.fr/en" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://armelgandour.fr/" />
    <lastmod>2026-08-23</lastmod>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://armelgandour.fr/en</loc>
    <xhtml:link rel="alternate" hreflang="fr" href="https://armelgandour.fr/" />
    <xhtml:link rel="alternate" hreflang="en" href="https://armelgandour.fr/en" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://armelgandour.fr/" />
    <lastmod>2026-08-23</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
  </url>
</urlset>
